---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import { IMAGES } from '../../data/images';
import { UI } from '../../data/i18n';

const t = UI.en;
---

<Layout title="Home" lang="en">
  <!-- 1. Hero Slider -->
  <HeroSlider lang="en" />

  <!-- 2. About us / Drones -->
  <section id="drones" class="relative py-24 lg:py-32 bg-[#0B0B0B] bg-tech-grid overflow-hidden">
    <div class="pointer-events-none absolute -top-24 -left-24 w-[420px] h-[420px] rounded-full bg-[#EE763C]/12 blur-[110px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 relative">
          <div class="glass-panel p-2">
            <Image
              src={IMAGES.dronAerotools}
              alt="Aerotools industrial drone"
              width={720}
              loading="eager"
              class="w-full h-[410px] object-cover rounded-[14px]"
            />
          </div>
          <div class="mt-6 sm:mt-0 sm:absolute sm:-bottom-6 sm:-right-6 glass-panel border-beam bg-[#0D0E12]/90 px-7 py-5 rounded-2xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/55">Inspected</p>
            <p class="font-mono text-3xl font-extrabold text-gradient-animated mt-1">8,600 MW</p>
          </div>
        </div>

        <div class="lg:col-span-7 lg:pl-8 space-y-6">
          <div class="atom-pill">About us</div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight">
            Drone Engineering for Industrial Applications
          </h2>
          <p class="text-white/70 text-base sm:text-lg leading-relaxed">
            Our mission is to achieve a high degree of innovation in the design, manufacturing,
            commercialization, and operation of drones (RPAS) and their associated applications.
          </p>

          <ul class="space-y-3.5 pt-2">
            {[
              'Applying drone engineering to optimize industrial workflows and asset management.',
              'Delivering innovative UAV solutions for industrial, security, and defense applications.',
              'Leading the drone sector through continuous innovation and engineering excellence.',
            ].map((item) => (
              <li class="flex items-start gap-3 text-white/85 font-medium">
                <span class="mt-1 w-5 h-5 rounded-md bg-brand-accent/15 border border-brand-accent/40 text-brand-accent flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="glass-card p-5">
              <h3 class="font-bold text-white text-base">
                Turnkey drone systems ready to fly and operate
              </h3>
            </div>
            <div class="glass-card p-5">
              <h3 class="font-bold text-white text-base">
                The most advanced industrial drones on the market
              </h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Equipment CTA -->
  <section class="relative py-20 bg-[#050505] text-white overflow-hidden border-y border-white/10">
    <Image
      src={IMAGES.base9}
      alt=""
      aria-hidden="true"
      width={1600}
      class="absolute inset-0 w-full h-full object-cover opacity-15"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#050505]/95 via-[#0B0B0B]/75 to-[#050505]/95"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-snug text-white">
        Multirotor and fixed-wing drones for industrial, agroforestry, surveillance, and conservation applications
      </h2>
      <div class="pt-2">
        <a href="/en/contact" class="glass-button-cta">
          Request a quote
        </a>
      </div>
    </div>
  </section>

  <!-- 4. R&D Projects -->
  <section id="projects" class="relative py-24 lg:py-32 bg-[#0B0B0B] overflow-hidden">
    <div class="pointer-events-none absolute bottom-10 right-0 w-[450px] h-[450px] rounded-full bg-[#EE763C]/10 blur-[120px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="atom-pill">R&amp;D Projects</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Projects</h2>
        <p class="text-white/70 leading-relaxed">
          At Aerotools we continuously invest in R&amp;D projects to develop advanced capabilities for
          industrial UAV applications—designing and optimizing multirotor and fixed-wing systems,
          integrating onboard sensors, and establishing standardized operational protocols.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {t.projects.map((project) => (
          <article class="glass-card group relative overflow-hidden p-0">
            <Image
              src={project.image}
              alt={project.title}
              width={520}
              class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#050505]/95 via-[#0B0B0B]/35 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-brand-accent">
                {project.category}
              </p>
              <h3 class="text-xl font-bold text-white mt-1">{project.title}</h3>
            </div>
          </article>
        ))}
      </div>

      <!-- ATOM@EDGE Highlight with Border Beam -->
      <div class="mt-14 glass-panel border-beam bg-[#0D0E12]/80 p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-3 flex flex-col items-center justify-center gap-4 bg-white rounded-2xl p-6 shadow-xl">
          <Image
            src={IMAGES.logoAtomVertical}
            alt="ATOM UAS"
            width={240}
            class="max-h-36 w-auto object-contain"
          />
          <Image
            src={IMAGES.banderasHorizontal}
            alt="Funded by the European Union - NextGenerationEU"
            width={300}
            class="w-full max-w-[240px] object-contain"
          />
        </div>
        <div class="lg:col-span-9 space-y-4 text-sm sm:text-base text-white/75 leading-relaxed">
          <div class="atom-pill">
            <span class="live-fleet-dot"></span>
            Technology Platform
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-gradient-animated">ATOM@EDGE</h3>
          <p>
            Our project <strong class="text-white">“ATOM@EDGE: Intelligent and reliable drone-based industrial asset inspection system powered by Artificial Intelligence and Edge Computing”</strong>
            is co-funded by <strong class="text-white">NextGenerationEU</strong> funds from the
            <strong class="text-white">European Union</strong>, and the
            <strong class="text-white">Recovery, Transformation and Resilience Plan</strong> of the
            <strong class="text-white">Government of Spain</strong>.
          </p>
          <p class="text-white/65">
            Within ATOM@EDGE, we have developed AI and Edge Computing capabilities that elevate industrial
            asset inspection. In utility-scale Solar PV, radiometric thermography of modules, combiner boxes,
            and inverters, automated serial-number reading for module traceability, and electroluminescence
            are enhanced through ATOM@EDGE to deliver high-value operational intelligence to our clients.
          </p>
          <p class="text-xs sm:text-sm text-white/55">
            Supported by <strong class="text-white">RED.ES</strong> under its R&amp;D AI &amp; Digital Technologies program (<strong class="text-white">C005/21-ED</strong>).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Services / Drone Operations -->
  <section id="services" class="relative py-24 lg:py-32 bg-[#050505] bg-tech-grid overflow-hidden border-t border-white/10">
    <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 w-[520px] h-[320px] rounded-full bg-[#EE763C]/10 blur-[130px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="atom-pill mx-auto">Services</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          Drone Operations
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        {t.operations.map((op, i) => (
          <div class="glass-card group p-8 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="w-12 h-12 rounded-xl bg-brand-accent/15 border border-brand-accent/35 font-mono text-brand-accent font-bold text-base flex items-center justify-center group-hover:bg-brand-accent group-hover:text-white group-hover:shadow-[0_0_18px_rgba(238,118,60,0.55)] transition-all">
                0{i + 1}
              </div>
              <h3 class="text-xl font-bold text-white">{op.title}</h3>
              <p class="text-white/65 text-sm sm:text-base leading-relaxed">
                {op.description}
              </p>
            </div>
            <div class="pt-6">
              <a
                href="/en/contact"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-accent hover:text-white transition-colors"
              >
                Request information
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Track record & ATOM global -->
  <section class="relative py-24 bg-[#0B0B0B] text-white border-y border-white/10 overflow-hidden">
    <div class="pointer-events-none absolute -bottom-20 -left-20 w-[380px] h-[380px] rounded-full bg-[#EE763C]/10 blur-[110px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-5">
        <div class="atom-pill">Track Record</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold">Over 10 years of UAV innovation</h2>
        <p class="text-white/75 leading-relaxed">
          Since May 2013, we have been developing proprietary drone engineering knowledge and turning
          aerial technology into measurable operational value for industrial clients.
        </p>
        <p class="text-white/65 text-sm sm:text-base leading-relaxed">
          ATOM is our global platform for industrial asset inspection: over
          <strong class="text-white">8,600 MW</strong> inspected across
          <strong class="text-white">250 utility-scale solar plants</strong> in
          <strong class="text-white">12 countries</strong>.
        </p>
        <div class="grid grid-cols-3 gap-4 pt-4">
          <div class="glass-panel p-4 text-center">
            <p class="font-mono text-2xl sm:text-3xl font-extrabold text-gradient-animated">8,600+</p>
            <p class="text-xs text-white/55 mt-1">MW inspected</p>
          </div>
          <div class="glass-panel p-4 text-center">
            <p class="font-mono text-2xl sm:text-3xl font-extrabold text-gradient-animated">250+</p>
            <p class="text-xs text-white/55 mt-1">Solar PV plants</p>
          </div>
          <div class="glass-panel p-4 text-center">
            <p class="font-mono text-2xl sm:text-3xl font-extrabold text-gradient-animated">12+</p>
            <p class="text-xs text-white/55 mt-1">Countries</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="glass-panel p-2">
          <Image
            src={IMAGES.separadorAtom}
            alt="Aerotools ATOM global operations"
            width={820}
            class="w-full h-[360px] object-cover rounded-[14px]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Consulting -->
  <section class="py-24 lg:py-32 bg-[#050505]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5 space-y-5">
        <div class="atom-pill">Consulting</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          Specialized services for enterprises
        </h2>
        <p class="text-white/70 leading-relaxed">
          Aerotools provides specialized UAV consulting for organizations looking to integrate drones
          into their industrial workflows and scale their technical operations.
        </p>
        <div class="pt-2">
          <a href="/en/contact" class="glass-button-cta">
            Learn more
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 grid grid-cols-2 gap-4">
        <Image
          src={IMAGES.consultoria1}
          alt="Enterprise drone consulting"
          width={520}
          class="rounded-2xl w-full h-64 sm:h-80 object-cover border border-white/10 shadow-2xl row-span-2"
        />
        <Image
          src={IMAGES.consultoria2}
          alt="Technical drone operations"
          width={520}
          class="rounded-2xl w-full h-32 sm:h-38 object-cover border border-white/10 shadow-2xl"
        />
        <Image
          src={IMAGES.consultoria3}
          alt="Industrial data analysis"
          width={520}
          class="rounded-2xl w-full h-32 sm:h-38 object-cover border border-white/10 shadow-2xl"
        />
      </div>
    </div>
  </section>
</Layout>
