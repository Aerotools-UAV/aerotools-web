---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
---

<Layout title="Contact" lang="en" description="Contact Aerotools UAV in Alcobendas, Madrid, Spain.">
  <section class="bg-brand-darker text-white py-16 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">
        <a href="/en/" class="hover:underline">Home</a> / Contact
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mt-3">Contact</h1>
    </div>
  </section>

  <section class="py-20 bg-[#0B0B0B] bg-tech-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-6">
        <div class="atom-pill">Get in touch</div>
        <h2 class="text-3xl font-extrabold text-white">Send us a message</h2>
        <p class="text-white/70 leading-relaxed">
          Tell us about your project, solar PV inspection, or UAV engineering needs and our team
          will get back to you promptly.
        </p>

        <div class="space-y-4 pt-2 text-sm">
          <div class="glass-panel p-5">
            <p class="font-bold text-white">Address</p>
            <p class="text-white/65 mt-1">{SITE.addressLines.join(', ')}, Spain</p>
          </div>
          <div class="glass-panel p-5">
            <p class="font-bold text-white">Phone</p>
            <a href={SITE.phoneHref} class="text-brand-accent font-semibold mt-1 inline-block hover:underline">
              {SITE.phone}
            </a>
          </div>
          <div class="glass-panel p-5">
            <p class="font-bold text-white">Email</p>
            <a href={`mailto:${SITE.email}`} class="text-brand-accent font-semibold mt-1 inline-block hover:underline">
              {SITE.email}
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form
          id="contact-form-en"
          action="/api/contacto"
          method="post"
          class="glass-panel p-8 sm:p-10 space-y-5"
        >
          <!-- Hidden anti-bot honeypot -->
          <div class="hidden" aria-hidden="true">
            <label for="website-en">Website</label>
            <input id="website-en" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre-en" class="block text-sm font-semibold text-white/85 mb-1.5">
                Name <span class="text-brand-accent">*</span>
              </label>
              <input
                id="nombre-en"
                name="nombre"
                type="text"
                required
                maxlength="100"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
            <div>
              <label for="email-en" class="block text-sm font-semibold text-white/85 mb-1.5">
                Email <span class="text-brand-accent">*</span>
              </label>
              <input
                id="email-en"
                name="email"
                type="email"
                required
                maxlength="150"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="telefono-en" class="block text-sm font-semibold text-white/85 mb-1.5">
                Phone <span class="text-white/40 font-normal">(optional)</span>
              </label>
              <input
                id="telefono-en"
                name="telefono"
                type="tel"
                maxlength="30"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
            <div>
              <label for="empresa-en" class="block text-sm font-semibold text-white/85 mb-1.5">
                Company <span class="text-white/40 font-normal">(optional)</span>
              </label>
              <input
                id="empresa-en"
                name="empresa"
                type="text"
                maxlength="120"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="mensaje-en" class="block text-sm font-semibold text-white/85 mb-1.5">
              Message <span class="text-brand-accent">*</span>
            </label>
            <textarea
              id="mensaje-en"
              name="mensaje"
              rows="5"
              required
              maxlength="5000"
              class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
            ></textarea>
          </div>

          <div id="contact-status-en" class="hidden rounded-xl px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></div>

          <button
            id="contact-submit-en"
            type="submit"
            class="glass-button-cta"
          >
            Send message
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactFormEn() {
    const form = document.getElementById('contact-form-en') as HTMLFormElement | null;
    const statusEl = document.getElementById('contact-status-en');
    const submitBtn = document.getElementById('contact-submit-en') as HTMLButtonElement | null;
    if (!form || !statusEl || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        nombre: String(fd.get('nombre') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        telefono: String(fd.get('telefono') || '').trim(),
        empresa: String(fd.get('empresa') || '').trim(),
        mensaje: String(fd.get('mensaje') || '').trim(),
        website: String(fd.get('website') || ''),
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      statusEl.classList.add('hidden');

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({ ok: false, error: 'Invalid server response.' }));
        if (res.ok && data.ok) {
          statusEl.textContent = 'Message sent successfully! We will get back to you shortly.';
          statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-emerald-500/15 border border-emerald-400/40 text-emerald-200';
          form.reset();
        } else {
          statusEl.textContent = data.error || 'Could not send the message. Please try again.';
          statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-red-500/15 border border-red-400/40 text-red-200';
        }
      } catch {
        statusEl.textContent = 'Could not reach /api/contacto (requires Cloudflare Pages in production).';
        statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-amber-500/15 border border-amber-400/40 text-amber-200';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    });
  }

  initContactFormEn();
  document.addEventListener('astro:after-swap', initContactFormEn);
</script>
