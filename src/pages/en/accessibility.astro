---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
---

<Layout title="Accessibility" lang="en">
  <section class="bg-brand-darker text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-accent">
        <a href="/en/" class="hover:underline">Home</a> / Accessibility
      </p>
      <h1 class="text-4xl font-extrabold mt-3">Accessibility</h1>
    </div>
  </section>

  <article class="py-16 bg-brand-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-gray-300 leading-relaxed">
      <p>
        <strong class="text-white">AeroTools-UAV</strong> is committed to making its website accessible in
        accordance with UNE-EN 301 549 and WCAG 2.1 guidelines.
      </p>
      <p>
        This website includes semantic headings, keyboard navigation support, skip-to-content links, and high-contrast
        typography.
      </p>
      <h2 class="text-2xl font-bold text-white pt-4">Feedback &amp; Contact</h2>
      <p>
        If you encounter any accessibility barriers or have suggestions for improvement, please contact us at
        <a href={`mailto:${SITE.email}`} class="text-brand-accent font-semibold hover:underline">{SITE.email}</a>.
      </p>
    </div>
  </article>
</Layout>
