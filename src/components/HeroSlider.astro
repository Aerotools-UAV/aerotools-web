---
import { Image } from 'astro:assets';
import { UI, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const hero = UI[lang].hero;
---

<section class="relative bg-[#050505] text-white overflow-hidden">
  <div id="hero-slider" class="relative min-h-[600px] sm:min-h-[660px] lg:min-h-[700px]">
    {hero.slides.map((slide, index) => (
      <div
        data-slide={index}
        class:list={[
          'hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out flex items-center',
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none',
        ]}
      >
        <Image
          src={slide.image}
          alt={slide.title}
          width={1920}
          quality={82}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505]/95 via-[#0B0B0B]/75 to-[#0B0B0B]/30"></div>
        <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-[#0B0B0B] to-transparent"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
          <div class="max-w-3xl space-y-6">
            <div class="atom-pill">
              <span class="live-fleet-dot"></span>
              <span>{slide.eyebrow}</span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.08] tracking-tight text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.6)]">
              {slide.title}
            </h1>
            <p class="text-base sm:text-lg text-white/75 leading-relaxed max-w-2xl">
              {slide.description}
            </p>
            <div class="pt-2 flex flex-wrap gap-4">
              <a href={slide.ctaHref} class="glass-button-cta">
                {slide.ctaLabel}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- ATOM Glass Controls -->
    <div class="absolute bottom-8 left-0 right-0 z-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <div
          class="inline-flex items-center gap-2.5 px-3.5 py-2 rounded-full bg-[#0D0E12]/70 backdrop-blur-xl border border-white/10"
          role="tablist"
          aria-label={hero.slidesLabel}
        >
          {hero.slides.map((slide, index) => (
            <button
              type="button"
              data-dot={index}
              aria-label={`${index + 1}: ${slide.title}`}
              class:list={[
                'hero-dot h-2 rounded-full transition-all cursor-pointer',
                index === 0 ? 'w-10 bg-brand-accent shadow-[0_0_10px_#EE763C]' : 'w-2.5 bg-white/30 hover:bg-white/60',
              ]}
            />
          ))}
        </div>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="hero-prev"
            aria-label={hero.prev}
            class="w-10 h-10 rounded-full bg-[#121216]/75 backdrop-blur-md border border-white/15 hover:bg-brand-accent hover:border-brand-accent hover:scale-105 hover:shadow-[0_0_16px_rgba(238,118,60,0.45)] text-white flex items-center justify-center transition-all cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            type="button"
            id="hero-next"
            aria-label={hero.next}
            class="w-10 h-10 rounded-full bg-[#121216]/75 backdrop-blur-md border border-white/15 hover:bg-brand-accent hover:border-brand-accent hover:scale-105 hover:shadow-[0_0_16px_rgba(238,118,60,0.45)] text-white flex items-center justify-center transition-all cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initHeroSlider() {
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.hero-dot'));
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    if (!slides.length) return;

    let current = 0;
    let timer: number | undefined;

    function goTo(idx: number) {
      current = (idx + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle('opacity-100', active);
        s.classList.toggle('z-10', active);
        s.classList.toggle('opacity-0', !active);
        s.classList.toggle('z-0', !active);
        s.classList.toggle('pointer-events-none', !active);
      });
      dots.forEach((d, i) => {
        const active = i === current;
        d.classList.toggle('w-10', active);
        d.classList.toggle('bg-brand-accent', active);
        d.classList.toggle('w-2.5', !active);
        d.classList.toggle('bg-white/30', !active);
      });
    }

    function restart() {
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(() => goTo(current + 1), 6500);
    }

    prevBtn?.addEventListener('click', () => { goTo(current - 1); restart(); });
    nextBtn?.addEventListener('click', () => { goTo(current + 1); restart(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); restart(); }));

    restart();
  }

  initHeroSlider();
  document.addEventListener('astro:after-swap', initHeroSlider);
</script>
