---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
---

<Layout title="Legal Notice" lang="en">
  <section class="bg-brand-darker text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-accent">
        <a href="/en/" class="hover:underline">Home</a> / Legal Notice
      </p>
      <h1 class="text-4xl font-extrabold mt-3">Legal Notice</h1>
    </div>
  </section>

  <article class="py-16 bg-brand-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-gray-300 leading-relaxed">
      <h2 class="text-2xl font-bold text-white">Company Information</h2>
      <ul class="list-disc pl-6 space-y-1">
        <li><strong class="text-white">Company Name:</strong> {SITE.legalName}</li>
        <li><strong class="text-white">Trade Name:</strong> Aerotools</li>
        <li><strong class="text-white">Tax ID (NIF/CIF):</strong> {SITE.nif}</li>
        <li><strong class="text-white">Address:</strong> {SITE.addressLines.join(', ')}, Spain</li>
        <li><strong class="text-white">Email:</strong> {SITE.email}</li>
      </ul>

      <p>
        {SITE.legalName} (hereinafter Aerotools) complies with Spanish Organic Law 3/2018 (LOPD-GDD), Regulation (EU)
        2016/679 (GDPR), and Spanish Law 34/2002 on Information Society Services and Electronic Commerce (LSSICE).
      </p>

      <h2 class="text-2xl font-bold text-white pt-4">Terms of Use</h2>
      <p>
        Accessing and browsing this website implies acceptance of these general terms of use. Users undertake to use
        this website and its contents lawfully and in good faith. Reproduction, distribution, or commercial use of any
        content without prior written authorization from Aerotools is prohibited.
      </p>

      <h2 class="text-2xl font-bold text-white pt-4">Privacy &amp; Data Protection</h2>
      <p>
        Please review our <a href="/en/privacy-policy" class="text-brand-accent font-semibold hover:underline">Privacy Policy</a>
        for full details on how we process personal data.
      </p>

      <h2 class="text-2xl font-bold text-white pt-4">Contact</h2>
      <p>
        For any legal inquiries, please contact us at
        <a href={`mailto:${SITE.email}`} class="text-brand-accent font-semibold hover:underline">{SITE.email}</a>.
      </p>
    </div>
  </article>
</Layout>
