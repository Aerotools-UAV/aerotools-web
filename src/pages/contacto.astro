---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout title="Contacto" lang="es" description="Contacta con Aerotools UAV en Alcobendas, Madrid.">
  <section class="bg-brand-darker text-white py-16 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">
        <a href="/" class="hover:underline">Inicio</a> / Contacto
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mt-3">Contacto</h1>
    </div>
  </section>

  <section class="py-20 bg-[#0B0B0B] bg-tech-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-6">
        <div class="atom-pill">Contacta con nosotros</div>
        <h2 class="text-3xl font-extrabold text-white">Escríbenos un mensaje</h2>
        <p class="text-white/70 leading-relaxed">
          Cuéntanos qué proyecto, inspección o solución con drones necesitas y nuestro equipo de
          ingeniería se pondrá en contacto contigo.
        </p>

        <div class="space-y-4 pt-2 text-sm">
          <div class="glass-panel p-5">
            <p class="font-bold text-white">Dirección</p>
            <p class="text-white/65 mt-1">{SITE.addressLines.join(', ')}</p>
          </div>
          <div class="glass-panel p-5">
            <p class="font-bold text-white">Teléfono</p>
            <a href={SITE.phoneHref} class="text-brand-accent font-semibold mt-1 inline-block hover:underline">
              {SITE.phone}
            </a>
          </div>
          <div class="glass-panel p-5">
            <p class="font-bold text-white">Correo electrónico</p>
            <a href={`mailto:${SITE.email}`} class="text-brand-accent font-semibold mt-1 inline-block hover:underline">
              {SITE.email}
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form
          id="contact-form"
          action="/api/contacto"
          method="post"
          class="glass-panel p-8 sm:p-10 space-y-5"
        >
          <!-- Campo honeypot anti-bots (debe permanecer vacío y oculto) -->
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-sm font-semibold text-white/85 mb-1.5">
                Nombre <span class="text-brand-accent">*</span>
              </label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                required
                maxlength="100"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-white/85 mb-1.5">
                Correo electrónico <span class="text-brand-accent">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength="150"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="telefono" class="block text-sm font-semibold text-white/85 mb-1.5">
                Teléfono <span class="text-white/40 font-normal">(opcional)</span>
              </label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                maxlength="30"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
            <div>
              <label for="empresa" class="block text-sm font-semibold text-white/85 mb-1.5">
                Empresa <span class="text-white/40 font-normal">(opcional)</span>
              </label>
              <input
                id="empresa"
                name="empresa"
                type="text"
                maxlength="120"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-semibold text-white/85 mb-1.5">
              Mensaje <span class="text-brand-accent">*</span>
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              required
              maxlength="5000"
              class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/15 text-white text-sm placeholder:text-white/35 focus:outline-none focus:border-brand-accent transition-colors"
            ></textarea>
          </div>

          <div id="contact-status" class="hidden rounded-xl px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></div>

          <button
            id="contact-submit"
            type="submit"
            class="glass-button-cta"
          >
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    if (!form || !statusEl || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        nombre: String(fd.get('nombre') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        telefono: String(fd.get('telefono') || '').trim(),
        empresa: String(fd.get('empresa') || '').trim(),
        mensaje: String(fd.get('mensaje') || '').trim(),
        website: String(fd.get('website') || ''),
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      statusEl.classList.add('hidden');

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({ ok: false, error: 'Respuesta no válida del servidor.' }));
        if (res.ok && data.ok) {
          statusEl.textContent = '¡Mensaje enviado correctamente! Te responderemos muy pronto.';
          statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-emerald-500/15 border border-emerald-400/40 text-emerald-200';
          form.reset();
        } else {
          statusEl.textContent = data.error || 'No se pudo enviar el mensaje. Inténtalo de nuevo.';
          statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-red-500/15 border border-red-400/40 text-red-200';
        }
      } catch {
        statusEl.textContent = 'Error de conexión con /api/contacto (en local requiere Cloudflare Pages).';
        statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-amber-500/15 border border-amber-400/40 text-amber-200';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar mensaje';
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
