---
import Layout from '../../layouts/Layout.astro';

const pages = [
  { label: 'Home', href: '/en/' },
  { label: 'Drones & About Us', href: '/en/#drones' },
  { label: 'R&D Projects', href: '/en/#projects' },
  { label: 'Services & Drone Operations', href: '/en/#services' },
  { label: 'Contact', href: '/en/contact' },
  { label: 'Legal Notice', href: '/en/legal-notice' },
  { label: 'Privacy Policy', href: '/en/privacy-policy' },
  { label: 'Accessibility', href: '/en/accessibility' },
  { label: 'Sitemap', href: '/en/sitemap' },
];
---

<Layout title="Sitemap" lang="en">
  <section class="bg-brand-darker text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-accent">
        <a href="/en/" class="hover:underline">Home</a> / Sitemap
      </p>
      <h1 class="text-4xl font-extrabold mt-3">Sitemap</h1>
    </div>
  </section>

  <section class="py-16 bg-brand-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white mb-6">Pages</h2>
      <ul class="space-y-3">
        {pages.map((p) => (
          <li>
            <a
              href={p.href}
              class="inline-flex items-center gap-2 text-white hover:text-brand-accent font-medium transition-colors"
            >
              <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
              {p.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
