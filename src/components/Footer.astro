---
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import { IMAGES } from '../data/images';
import { UI, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = UI[lang];
const homeHref = lang === 'es' ? '/' : '/en/';
const year = new Date().getFullYear();
---

<footer class="bg-brand-darker text-white/80 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="space-y-4">
        <a href={homeHref} class="inline-block">
          <Image
            src={IMAGES.aerotoolsLogo}
            alt={SITE.name}
            width={170}
            class="h-10 w-auto object-contain"
          />
        </a>
        <p class="text-sm leading-relaxed text-white/70">
          {t.tagline}
        </p>
        <div class="flex items-center gap-2.5 pt-2">
          {SITE.socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              title={s.name}
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-brand-accent text-white flex items-center justify-center transition-colors"
            >
              {s.icon === 'linkedin' && (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
              {s.icon === 'youtube' && (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              )}
              {s.icon === 'x' && (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {s.icon === 'facebook' && (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-white font-bold text-base mb-4">{t.footer.explore}</h3>
        <ul class="space-y-2.5 text-sm">
          {t.nav.map((link) => (
            <li>
              <a href={link.href} class="hover:text-brand-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold text-base mb-4">{t.footer.contact}</h3>
        <address class="not-italic text-sm space-y-1 text-white/70">
          {SITE.addressLines.map((line) => (
            <p>{line}</p>
          ))}
        </address>
        <div class="mt-4 space-y-1">
          <a href={SITE.phoneHref} class="block text-base font-bold text-white hover:text-brand-accent transition-colors">
            {SITE.phone}
          </a>
          <a href={`mailto:${SITE.email}`} class="block text-sm text-brand-accent hover:underline">
            {SITE.email}
          </a>
        </div>
      </div>

      <!-- Quick email CTA -->
      <div>
        <h3 class="text-white font-bold text-base mb-4">{t.footer.emailCta}</h3>
        <form
          id="footer-contact-form"
          action="/api/contacto"
          method="post"
          class="space-y-3"
          data-lang={lang}
        >
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" value="" />
          <label for="footer-email" class="sr-only">{t.footer.emailLabel}</label>
          <input
            id="footer-email"
            name="email"
            type="email"
            required
            placeholder={t.footer.emailPlaceholder}
            class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/15 text-sm text-white placeholder:text-white/40 focus:outline-none focus:border-brand-accent"
          />
          <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-brand-accent hover:bg-brand-accent-hover text-white text-sm font-semibold transition-colors cursor-pointer"
          >
            {t.footer.send}
          </button>
          <p id="footer-contact-status" class="hidden text-xs"></p>
        </form>
      </div>
    </div>

    <!-- Institutional & R&D Funding Logos (dark-first hierarchy matching official brand guidelines) -->
    <div class="mt-14 pt-10 border-t border-white/10 space-y-8">
      <!-- Fila 1: Banner Convocatoria NextGenerationEU / red.es / Plan de Recuperación -->
      <div class="flex justify-center">
        <div class="rounded-xl overflow-hidden bg-white p-1.5 shadow-lg max-w-2xl w-full">
          <Image
            src={IMAGES.logoConvocatoria}
            alt="Financiado por la Unión Europea NextGenerationEU - Gobierno de España - red.es - Plan de Recuperación"
            width={900}
            class="w-full h-auto object-contain rounded-lg"
          />
        </div>
      </div>

      <!-- Fila 2: Logos blancos sobre fondo oscuro (NextGenerationEU, Gobierno de España, Plan de Recuperación) -->
      <div class="glass-panel px-6 py-6 flex flex-wrap items-center justify-center gap-8 sm:gap-14">
        <Image
          src={IMAGES.logoNextGen}
          alt="Financiado por la Unión Europea - NextGenerationEU"
          width={220}
          class="h-11 sm:h-12 w-auto object-contain opacity-95 hover:opacity-100 transition-opacity"
        />
        <Image
          src={IMAGES.logoGobierno}
          alt="Gobierno de España"
          width={180}
          class="h-12 sm:h-14 w-auto object-contain opacity-95 hover:opacity-100 transition-opacity"
        />
        <Image
          src={IMAGES.logoPlanRecuperacion}
          alt="Plan de Recuperación, Transformación y Resiliencia"
          width={220}
          class="h-11 sm:h-12 w-auto object-contain opacity-95 hover:opacity-100 transition-opacity"
        />
      </div>

      <!-- Fila 3: FEDER / CDTI, PYME Innovadora e ICEX Next -->
      <div class="flex flex-wrap items-center justify-center gap-5 sm:gap-6">
        <div class="rounded-xl overflow-hidden bg-white p-2 shadow-lg">
          <Image
            src={IMAGES.logoCdtiUe}
            alt="Unión Europea FEDER - CDTI Centro para el Desarrollo Tecnológico Industrial"
            width={420}
            class="h-12 sm:h-14 w-auto object-contain"
          />
        </div>
        <div class="rounded-xl overflow-hidden bg-white p-2 shadow-lg">
          <Image
            src={IMAGES.logoPymeInnovadora}
            alt="Sello PYME Innovadora - Ministerio de Ciencia e Innovación"
            width={160}
            class="h-14 sm:h-16 w-auto object-contain"
          />
        </div>
        <div class="rounded-xl overflow-hidden bg-white p-2 shadow-lg">
          <Image
            src={IMAGES.logoIcex}
            alt="ICEX Next - Fondo Europeo de Desarrollo Regional"
            width={280}
            class="h-12 sm:h-14 w-auto object-contain"
          />
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/60">
      <div class="flex flex-wrap items-center justify-center gap-3">
        {t.footer.legal.map((item, idx) => (
          <>
            {idx > 0 && <span>|</span>}
            <a href={item.href} class="hover:text-white transition-colors">{item.label}</a>
          </>
        ))}
      </div>
      <p>© {year} AeroTools-UAV. {t.footer.rights}</p>
    </div>
  </div>
</footer>

<script>
  function initFooterForm() {
    const form = document.getElementById('footer-contact-form') as HTMLFormElement | null;
    const status = document.getElementById('footer-contact-status');
    if (!form || !status) return;
    const isEn = form.dataset.lang === 'en';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const website = String(fd.get('website') || '');
      status.classList.remove('hidden');
      status.className = 'text-xs text-white/70';
      status.textContent = isEn ? 'Sending...' : 'Enviando...';

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            nombre: isEn ? 'Quick Footer Request' : 'Contacto rápido desde web',
            email,
            mensaje: isEn
              ? `User requested contact via footer quick form (${email}).`
              : `Solicitud de contacto rápido desde el pie de página (${email}).`,
            website,
          }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (res.ok && data.ok) {
          status.className = 'text-xs text-emerald-300';
          status.textContent = isEn ? 'Sent! We will contact you soon.' : '¡Enviado! Te contactaremos pronto.';
          form.reset();
        } else {
          status.className = 'text-xs text-red-300';
          status.textContent = data.error || (isEn ? 'Could not send.' : 'No se pudo enviar.');
        }
      } catch {
        status.className = 'text-xs text-amber-300';
        status.textContent = isEn
          ? 'API /api/contacto requires Cloudflare Pages.'
          : 'La API /api/contacto requiere Cloudflare Pages.';
      }
    });
  }

  initFooterForm();
  document.addEventListener('astro:after-swap', initFooterForm);
</script>
